GITHUB_TOKEN=

# Canonical site URL for OpenGraph, sitemap and robots (falls back to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=

# --- Admin panel (/admin) for the UI/UX gallery ---
# Your login password. At least 12 characters; use a long random passphrase.
ADMIN_PASSWORD=
# Signs the login cookie. At least 32 random characters. Change it to sign out every device.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Supabase Storage holds the uploaded media. Never expose the service key to the browser.
SUPABASE_URL=https://nqysiprpmxxombsdvdkh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for media (defaults to "portfolio") and per-file limit in MB (defaults to 50).
DESIGNS_BUCKET=
DESIGNS_MAX_UPLOAD_MB=
