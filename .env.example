GITHUB_TOKEN=

# Canonical site URL for OpenGraph, sitemap and robots (falls back to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=

# --- Admin panel (/admin) for the UI/UX gallery ---
# Your login password. At least 12 characters; use a long random passphrase.
ADMIN_PASSWORD=
# Signs the login cookie. At least 32 random characters. Change it to sign out every device.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Supabase Storage holds the uploaded media. Never expose the service key to the browser.
SUPABASE_URL=https://nqysiprpmxxombsdvdkh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for media (defaults to "portfolio") and per-file limit in MB (defaults to 50).
DESIGNS_BUCKET=
DESIGNS_MAX_UPLOAD_MB=

# --- Analytics (PostHog) ---
# Browser key: sends page views and events. Find it in PostHog > Project settings.
NEXT_PUBLIC_POSTHOG_KEY=
# Your PostHog region's ingestion host. The browser never calls it directly:
# events go through this site's /sp path, which next.config.ts rewrites here.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-only: reads the numbers for the Insights section. Create a personal API key
# with the "Query: read" scope, and copy the numeric project id from the project URL.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# https://us.posthog.com or https://eu.posthog.com
POSTHOG_API_HOST=https://us.posthog.com
